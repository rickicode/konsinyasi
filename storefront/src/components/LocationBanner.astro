---
// LocationBanner.astro - GPS activation banner
---

<div class="loc-banner" id="loc-banner" role="region" aria-label="Status lokasi">
  <div class="loc-icon">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="3"/>
      <path d="M12 2v4M12 18v4M2 12h4M18 12h4"/>
    </svg>
  </div>
  <div class="loc-text">
    <h3 id="loc-title">Aktifkan Lokasi</h3>
    <p id="loc-desc">Untuk menemukan warung terdekat</p>
  </div>
  <button class="loc-btn" id="loc-btn" aria-label="Aktifkan lokasi GPS">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M5 12h14M12 5l7 7-7 7"/>
    </svg>
  </button>
</div>

<style>
  .loc-banner {
    background: var(--coffee-700);
    border-radius: 16px;
    padding: 16px;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .loc-icon {
    width: 44px;
    height: 44px;
    background: rgba(255, 255, 255, 0.15);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: white;
  }

  .loc-text {
    flex: 1;
    min-width: 0;
  }

  .loc-text h3 {
    font-size: 14px;
    font-weight: 700;
    color: white;
    margin-bottom: 2px;
  }

  .loc-text p {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.75);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .loc-btn {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    border: none;
    background: white;
    color: var(--coffee-700);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: all 0.15s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .loc-btn:active {
    transform: scale(0.95);
  }

  :global(.loc-status) {
    padding: 6px 12px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.2);
    color: white;
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
    flex-shrink: 0;
  }
</style>
