---
// DetailModal.astro - Warung detail bottom sheet
---

<div class="detail-overlay" id="detail-overlay" role="dialog" aria-modal="true" aria-label="Detail warung">
  <div class="detail-sheet" id="detail">
    <div class="detail-handle" aria-hidden="true"></div>
    
    {/* Header */}
    <div class="detail-header">
      <div class="detail-header__info">
        <h2 class="detail-title" id="d-title">-</h2>
        <p class="detail-addr" id="d-addr">-</p>
        <p class="detail-dist" id="d-dist"></p>
      </div>
      <button class="detail-close" id="close-detail-btn" aria-label="Tutup">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>

    {/* Photo */}
    <img class="detail-photo" id="d-photo" src="" alt="" width="440" height="160" loading="lazy" decoding="async" style="display:none" />

    {/* Products */}
    <div class="detail-section">
      <h3 class="detail-section__title">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 01-8 0"/>
        </svg>
        Produk Tersedia
      </h3>
      <div class="detail-products" id="d-products"></div>
    </div>

    {/* Actions */}
    <div class="detail-actions">
      <button class="detail-btn detail-btn--nav" id="nav-btn" aria-label="Navigasi ke warung">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="3 11 22 2 13 21 11 13 3 11"/>
        </svg>
        Navigasi
      </button>
    </div>
  </div>
</div>

<style>
  .detail-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(0, 0, 0, 0.4);
    display: none;
    align-items: flex-end;
    justify-content: center;
  }

  .detail-overlay.active {
    display: flex;
  }

  .detail-sheet {
    background: white;
    border-radius: 20px 20px 0 0;
    width: 100%;
    max-width: 480px;
    max-height: 85vh;
    overflow-y: auto;
    padding-bottom: calc(20px + env(safe-area-inset-bottom));
    animation: sheet-up 0.3s ease;
  }

  @keyframes sheet-up {
    from { transform: translateY(100%); }
    to { transform: translateY(0); }
  }

  .detail-handle {
    width: 36px;
    height: 4px;
    background: var(--coffee-200);
    border-radius: 2px;
    margin: 12px auto 0;
  }

  .detail-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 20px 12px;
  }

  .detail-header__info {
    flex: 1;
    min-width: 0;
  }

  .detail-title {
    font-size: 18px;
    font-weight: 800;
    color: var(--coffee-900);
    margin-bottom: 4px;
    line-height: 1.3;
  }

  .detail-addr {
    font-size: 13px;
    color: var(--coffee-500);
    line-height: 1.4;
    margin-bottom: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .detail-dist {
    font-size: 12px;
    color: var(--caramel);
    font-weight: 600;
  }

  .detail-close {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    border: none;
    background: var(--coffee-50);
    color: var(--coffee-600);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
  }

  .detail-photo {
    width: calc(100% - 40px);
    margin: 0 20px 16px;
    height: 160px;
    object-fit: cover;
    border-radius: 12px;
  }

  .detail-section {
    padding: 0 20px;
  }

  .detail-section__title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 700;
    color: var(--coffee-700);
    margin-bottom: 12px;
  }

  .detail-products {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 20px;
  }

  .detail-product {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 12px;
    background: var(--coffee-50);
    border-radius: 8px;
  }

  .detail-product__info {
    flex: 1;
    min-width: 0;
  }

  .detail-product__name {
    font-size: 13px;
    font-weight: 600;
    color: var(--coffee-900);
    margin-bottom: 2px;
  }

  .detail-product__qty {
    font-size: 12px;
    color: var(--coffee-500);
  }

  .detail-product__price {
    font-size: 14px;
    font-weight: 700;
    color: var(--caramel);
    flex-shrink: 0;
    white-space: nowrap;
    margin-left: 12px;
  }

  .detail-actions {
    padding: 0 20px;
  }

  .detail-btn {
    width: 100%;
    padding: 14px;
    border-radius: 12px;
    border: none;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: all 0.15s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .detail-btn:active {
    transform: scale(0.98);
  }

  .detail-btn--nav {
    background: var(--coffee-700);
    color: white;
  }
</style>
