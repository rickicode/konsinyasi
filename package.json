{
  "name": "konsi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "kill-ports": "bash scripts/kill-ports.sh",
    "dev": "npm run kill-ports && sleep 3 && concurrently --names api,admin,store \"wrangler dev --port 5003 --host 0.0.0.0\" \"vite --port 5002 --host 0.0.0.0\" \"cd storefront && npm run dev\"",
    "dev:api": "npm run kill-ports && sleep 1 && wrangler dev --port 5003 --host 0.0.0.0",
    "dev:admin": "lsof -ti:5002 | xargs kill -9 2>/dev/null; sleep 1 && vite --port 5002 --host 0.0.0.0",
    "dev:storefront": "lsof -ti:5001 | xargs kill -9 2>/dev/null; sleep 1 && cd storefront && npm run dev -- --port 5001",
    "build": "vite build",
    "build:storefront": "cd storefront && npm run build",
    "deploy:storefront": "cd storefront && npm run deploy",
    "check": "tsc -b && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps"
  },
  "dependencies": {
    "@keenmate/svelte-spa-router": "^5.3.0",
    "@tanstack/svelte-query": "^6.0.0",
    "bits-ui": "^2.18.0",
    "clsx": "2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.0",
    "leaflet": "^1.9.4",
    "lucide-svelte": "^1.0.0",
    "tailwind-merge": "3.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250204.0",
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.61.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/leaflet": "^1.9.21",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "concurrently": "^10.0.4",
    "drizzle-kit": "^0.30.0",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.22.0",
    "jsdom": "^29.1.1",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.25.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.0.0",
    "workbox-background-sync": "^7.4.1",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.119.0"
  },
  "packageManager": "pnpm@9.15.0"
}
