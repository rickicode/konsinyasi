{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "basic-memory": {
      "enabled": true,
      "type": "local",
      "command": ["basic-memory", "mcp", "--project", "konsinyasi"],
    },
    "openlore": {
      "enabled": true,
      "type": "local",
      "command": ["npx", "--yes", "openlore", "mcp", "--preset", "substrate"],
    },
  },
}
