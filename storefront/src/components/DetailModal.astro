---
// DetailModal.astro - Warung detail bottom sheet
---

<div class="detail-overlay" id="detail-overlay" role="dialog" aria-modal="true" aria-label="Detail warung">
  <div class="detail-sheet" id="detail">
    <div class="detail-handle" aria-hidden="true"></div>
    
    {/* Header */}
    <div class="detail-header">
      <div class="detail-header__info">
        <h2 class="detail-title" id="d-title">-</h2>
        <p class="detail-addr" id="d-addr">-</p>
        <p class="detail-dist" id="d-dist"></p>
      </div>
      <button class="detail-close" id="close-detail-btn" aria-label="Tutup">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>

    {/* Photo */}
    <img class="detail-photo" id="d-photo" src="" alt="" width="440" height="160" loading="lazy" decoding="async" style="display:none" />

    {/* Products */}
    <div class="detail-section">
      <h3 class="detail-section__title">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 01-8 0"/>
        </svg>
        Produk Tersedia
      </h3>
      <div class="detail-products" id="d-products"></div>
    </div>

    {/* Actions */}
    <div class="detail-actions">
      <button class="detail-btn detail-btn--nav" id="nav-btn" aria-label="Navigasi ke warung">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="3 11 22 2 13 21 11 13 3 11"/>
        </svg>
        Navigasi
      </button>
    </div>
  </div>
</div>
