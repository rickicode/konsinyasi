---
// produk.astro - Products page
// Uses only shared building blocks: BaseLayout (global config + brand),
// Header component, design-system.css, and scripts/api + scripts/format.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';

const title = 'Produk — Konsi';
const description = 'Daftar produk kopi yang tersedia di Konsi.';
const baseUrl = import.meta.env.VITE_BASE_URL || 'https://kopi.hijitoko.com';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Produk Konsi',
  description: description,
  url: baseUrl + '/produk',
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <Header />

  <main class="main" role="main" id="main-content">
    <div class="page-header">
      <a href="/" class="back-btn" aria-label="Kembali">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
      </a>
      <h1 class="page-title">Produk Kami</h1>
    </div>

    <div class="products-list" id="products-list">
      <div class="loading">
        <div class="spinner"></div>
        <p>Memuat produk...</p>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  import { apiFetch } from '../scripts/api';
  import { escapeHtml, formatNumber, emptyHtml, errorHtml } from '../scripts/format';

  interface ProductItem {
    id: string;
    name: string;
    description?: string | null;
    // Consumer-facing price (worker already resolves price_to_consumer,
    // falling back to the outlet price for products without one).
    price: number;
    photo_url?: string | null;
  }

  async function loadProducts() {
    const listEl = document.getElementById('products-list');
    if (!listEl) return;

    try {
      const data = await apiFetch<{ products: ProductItem[] }>('/api/public/products');
      const products = data.products || [];

      if (!products.length) {
        listEl.innerHTML = emptyHtml('Belum Ada Produk', 'Produk akan muncul di sini');
        return;
      }

      listEl.innerHTML = products
        .map((p) => {
          const thumb = p.photo_url
            ? `<img src="${escapeHtml(p.photo_url)}" alt="${escapeHtml(p.name)}" width="56" height="56" loading="lazy">`
            : `<svg class="product-thumb-placeholder" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M18 8h1a4 4 0 010 8h-1"/>
                <path d="M2 8h16v9a4 4 0 01-4 4H6a4 4 0 01-4-4V8z"/>
                <path d="M6 1v3M10 1v3M14 1v3"/>
              </svg>`;

          return `
            <div class="product-card">
              <div class="product-thumb">
                ${thumb}
              </div>
              <div class="product-info">
                <div class="product-name">${escapeHtml(p.name)}</div>
                ${p.description ? `<div class="product-desc">${escapeHtml(p.description)}</div>` : ''}
              </div>
              <div class="product-price">Rp ${formatNumber(p.price)}</div>
            </div>
          `;
        })
        .join('');
    } catch (e) {
      console.error('Gagal memuat produk:', e);
      listEl.innerHTML = errorHtml('Gagal Memuat', 'Coba refresh halaman');
    }
  }

  loadProducts();
</script>
