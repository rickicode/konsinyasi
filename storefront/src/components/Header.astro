---
// Header.astro - Clean minimal header with brand logo support
---
<header class="header" role="banner">
  <div class="header-inner">
    <a href="/" class="logo" aria-label="Konsi - Temukan Kopi">
      <div class="logo-mark">
        <img 
          id="brand-logo-img" 
          src="" 
          alt="Logo" 
          style="display: none; width: 100%; height: 100%; object-fit: contain;"
          onerror="this.style.display='none'; document.getElementById('brand-logo-fallback').style.display='';"
        />
        <div id="brand-logo-fallback" class="logo-fallback">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
            <path d="M18 8h1a4 4 0 010 8h-1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            <path d="M2 8h16v9a4 4 0 01-4 4H6a4 4 0 01-4-4V8z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M6 1v3M10 1v3M14 1v3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </div>
      </div>
      <span class="logo-text" id="brand-logo-text">Konsi</span>
    </a>
    <a href="/produk" class="produk-btn" aria-label="Lihat produk">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 8h1a4 4 0 010 8h-1"/>
        <path d="M2 8h16v9a4 4 0 01-4 4H6a4 4 0 01-4-4V8z"/>
        <path d="M6 1v3M10 1v3M14 1v3"/>
      </svg>
    </a>
  </div>
</header>
<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    padding: env(safe-area-inset-top) 0 0;
  }
  .header-inner {
    max-width: 480px;
    margin: 0 auto;
    padding: 14px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--coffee-800);
  }
  /* The container has NO background on purpose: when a real (transparent)
     brand logo is loaded, it must sit on the clean header with no brown box.
     The brown chip belongs to the fallback icon only. */
  .logo-mark {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    overflow: hidden;
  }
  .logo-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background: var(--coffee-700);
    border-radius: 10px;
  }
  .logo-text {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.5px;
  }
  .produk-btn {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    border: none;
    background: var(--coffee-50);
    color: var(--coffee-700);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.15s ease;
    -webkit-tap-highlight-color: transparent;
    text-decoration: none;
  }
  .produk-btn:hover {
    background: var(--coffee-100);
  }
  .produk-btn:active {
    transform: scale(0.95);
  }
</style>
